# ─────────────────────────────────────────────────────────────
# lark-claude-bot 配置示例：复制本文件为 .env 后按需填写
# 规则：.env 里已存在的同名环境变量以系统环境变量为准（不覆盖）
# ─────────────────────────────────────────────────────────────

# 【必填】lark-cli profile 名（lark-cli config init --new --name <此值> 时填的）
LARK_PROFILE=claude

# 【必填】主人 open_id：私聊只回复此人，群聊也只有此人能触发写操作
# 获取方式：在飞书里给自己发消息，看 bot 日志里的 sender open_id
BOT_OWNER_OPEN_ID=

# 受信任群 chat_id（逗号分隔，可留空）
# 受信任群里：群友默认只读，只有主人能触发写操作；不在名单的群里所有人只读
BOT_TRUSTED_CHATS=

# 代码根目录：配置后机器人才具备"开发助手"能力（读源码、跑构建等）
BOT_CODE_ROOT=

# 技能库目录（每个子目录一个 SKILL.md），可留空
BOT_SKILLS_DIR=

# 共享记忆库目录（多 AI 工具共用），可留空
BOT_MEMORY_BANK=

# MCP 配置文件路径，默认 <本目录>/mcp-servers.json，不存在则不挂载
# 参考 mcp-servers.example.json，填好真实凭证后另存为 mcp-servers.json
BOT_MCP_CONFIG=

# 可选：桌面通知文件（如桌面宠物的 .buddy_notify），任务完成时写入触发提醒
BUDDY_NOTIFY_FILE=

# 可选：办公网封锁飞书 API 网段时的本地救急代理（如 http://127.0.0.1:8899）
# 正常网络留空即可；原理见 feishu-proxy.py
FEISHU_RESCUE_PROXY=

# 高级：lark-cli 配置目录，默认 <本目录>/lark-cli-home
# LARKSUITE_CLI_CONFIG_DIR=
